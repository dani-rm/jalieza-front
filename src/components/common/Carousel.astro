---
import { Picture } from "astro:assets";
import type { ImageMetadata } from "astro";

interface Slide {
    image: ImageMetadata;
    alt: string;
    title: string;
    description: string;
}

const { slides = [] } = Astro.props;
---

<div class="simple-carousel">
    {
        slides.map((slide: Slide, index: number) => (
            <div class={`slide ${index === 0 ? "active" : ""}`}>
                <Picture
                    src={slide.image}
                    alt={slide.alt}
                    widths={[600, 900, 1200]}
                    formats={["webp", "jpg"]}
                    sizes="100vw"
                    loading={index === 0 ? "eager" : "lazy"}
                />
                <div class="overlay">
                    <h3>{slide.title}</h3>
                    <p>{slide.description}</p>
                </div>
            </div>
        ))
    }

    <div class="dots">
        {
            slides.map((_: Slide, i: number) => (
                <span class={`dot ${i === 0 ? "active" : ""}`} />
            ))
        }
    </div>
</div>

<script>
    let current = 0;
    const slides = document.querySelectorAll(".slide");
    const dots = document.querySelectorAll(".dot");
    const total = slides.length;

    function next() {
        slides[current].classList.remove("active");
        dots[current].classList.remove("active");
        current = (current + 1) % total;
        slides[current].classList.add("active");
        dots[current].classList.add("active");
    }

    if (total > 1) setInterval(next, 5000);
</script>

<style>
    .simple-carousel {
        position: relative;
        height: 400px;
        border-radius: 1rem;
        overflow: hidden;
        box-shadow: 0 10px 30px rgba(0, 0, 0, 0.2);
    }

    .slide {
        position: absolute;
        inset: 0;
        visibility: hidden;
        opacity: 1;
        transition: visibility 0s ease 0.6s;
    }

    .slide.active {
        visibility: visible;
        transition: visibility 0s ease 0s;
    }

    .slide img {
        width: 100%;
        height: 100%;
        object-fit: cover;
        transition: transform 0.3s ease;
    }

    .slide:hover img {
        transform: scale(1.05);
    }

    .overlay {
        position: absolute;
        inset: 0;
        background: linear-gradient(
            45deg,
            rgba(0, 0, 0, 0.4),
            rgba(195, 42, 255, 0.1)
        );
        display: flex;
        flex-direction: column;
        justify-content: center;
        align-items: center;
        color: white;
        opacity: 0;
        transition: opacity 0.3s ease;
        text-align: center;
        padding: 2rem;
    }

    .slide:hover .overlay {
        opacity: 1;
    }

    .overlay h3 {
        font-size: 2rem;
        margin-bottom: 1rem;
        text-shadow: 2px 2px 4px rgba(0, 0, 0, 0.7);
    }

    .overlay p {
        font-size: 1.1rem;
        text-shadow: 1px 1px 2px rgba(0, 0, 0, 0.7);
    }

    .dots {
        position: absolute;
        bottom: 1rem;
        left: 50%;
        transform: translateX(-50%);
        display: flex;
        gap: 0.5rem;
    }

    .dot {
        width: 10px;
        height: 10px;
        border-radius: 50%;
        background: rgba(255, 255, 255, 0.5);
        border: 2px solid white;
        transition: all 0.3s ease;
    }

    .dot.active {
        background: white;
        transform: scale(1.2);
    }

    @media (max-width: 480px) {
        .simple-carousel {
            height: 300px;
        }
        .overlay h3 {
            font-size: 1.5rem;
        }
        .overlay p {
            font-size: 1rem;
        }
        .dots {
            bottom: 0.5rem;
        }
        .dot {
            width: 8px;
            height: 8px;
        }
    }
</style>
